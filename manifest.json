{
  "schemaVersion": 1,
  "id": "io.github.seyhunakyurek.omteleprompt",
  "name": "OmTeleprompt",
  "version": "1.0.0",
  "author": "seyhunakyurek",
  "license": "MIT",
  "description": "Teleprompter for interviewers and streamers with word tracking, voice activation, and pause-on-speak.",
  "kinds": ["bar-widget"],
  "entryPoints": { "barWidget": "BarWidget.qml" },
  "barWidget": {
    "displayName": "OmTeleprompt",
    "category": "Productivity",
    "allowMultiple": false,
    "defaultSection": "center",
    "defaults": {
      "fontSize": 36,
      "scrollSpeed": 1,
      "voiceEnabled": false,
      "vadThreshold": 500
    },
    "schema": [
      { "key": "fontSize", "type": "integer", "label": "Font Size", "defaultValue": 36, "min": 12, "max": 120, "step": 1 },
      { "key": "scrollSpeed", "type": "number", "label": "Scroll Speed", "defaultValue": 1, "min": 0.5, "max": 5, "step": 0.1 },
      { "key": "voiceEnabled", "type": "boolean", "label": "Voice Activation", "defaultValue": false },
      { "key": "vadThreshold", "type": "integer", "label": "VAD Sensitivity (lower = more sensitive)", "defaultValue": 500, "min": 100, "max": 3000, "step": 100 }
    ]
  }
}
